{
  "name": "burzblog-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build && node scripts/check-runtime.mjs",
    "start": "HOST=127.0.0.1 node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/sofia-sans": "5.3.0",
    "@iconify-json/lucide": "1.2.135",
    "@nuxt/ui": "4.11.0",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.5.0",
    "happy-dom": "20.14.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.15.1"
}
