# Copy to .env beside compose.yaml (or compose.dist.yaml) and adjust.
# Never put a password or token in this file.

# Numeric owner of the site directory (id -u / id -g). The container runs as it.
BURZBLOG_UID=1000
BURZBLOG_GID=1000

# Exact browser origin. Production: your HTTPS reverse-proxy address.
# Local trial: http://127.0.0.1:8080 (open exactly that URL).
BURZBLOG_ORIGIN=https://blog.example.org
# Host loopback port the reverse proxy forwards to.
BURZBLOG_PORT=8080

# Host directories; create them first (see docs/containers.md).
BURZBLOG_SITE_DIR=./site
# Content root inside the site, e.g. "content" when the Git repository root
# holds content/ next to other files. Empty means the site directory itself.
BURZBLOG_CONTENT_SUBDIR=
BURZBLOG_STATE_PATH=./state
BURZBLOG_SECRETS_DIR=./secrets

# Optional Git remote. For a private HTTPS repository also set a username and
# the in-container path of a 0600 token file stored in BURZBLOG_SECRETS_DIR.
# BURZBLOG_REMOTE_URL=https://git.example.org/owner/site.git
# BURZBLOG_REMOTE_NAME=origin
# BURZBLOG_REMOTE_USERNAME=site-bot
# BURZBLOG_REMOTE_TOKEN_FILE=/secrets/git-token
# BURZBLOG_REMOTE_CA_FILE=/secrets/internal-ca.pem

# compose.dist.yaml: the image to run. burzblog:local after `task docker:build`;
# a published image must be pinned by digest (ghcr.io/weburz/burzblog@sha256:...).
BURZBLOG_IMAGE=burzblog:local
