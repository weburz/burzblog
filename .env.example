# Copy to .env beside compose.yaml (or compose.dist.yaml) and adjust.

# Numeric owner of the data directory (id -u / id -g). The container runs as it.
BURZBLOG_UID=1000
BURZBLOG_GID=1000

# The exact public URL people open. Local trial: http://127.0.0.1:8080
BURZBLOG_ORIGIN=https://blog.example.org
# Host loopback port your reverse proxy forwards to.
BURZBLOG_PORT=8080

# Host directory for the database; create it first (mkdir -m 700 data).
BURZBLOG_DATA_DIR=./data

# Optional: POSTed after published posts change, e.g. a Vercel deploy hook.
# It is a secret; keep this file private.
# BURZBLOG_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...

# compose.dist.yaml: the image to run, pinned by digest when published.
BURZBLOG_IMAGE=burzblog:local
